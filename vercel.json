{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },

    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/index.html", "destination": "/admin/index.html" },
    { "source": "/admin/config.yml", "destination": "/admin/config.yml" },

    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },

    { "source": "/data/(.*)", "destination": "/data/$1" },
    { "source": "/uploads/(.*)", "destination": "/uploads/$1" },

    { "source": "/homeanalysis", "destination": "/" },
    { "source": "/(.*)", "destination": "/" }
  ]
}