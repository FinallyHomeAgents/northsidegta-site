{
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/Images/(.*)", "dest": "/Images/$1" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/data/(.*)", "dest": "/data/$1" },

    { "handle": "filesystem" },

    { "src": "/homeanalysis", "dest": "/" },
    { "src": "/.*", "dest": "/" }
  ]
}