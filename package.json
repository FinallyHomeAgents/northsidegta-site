{
  "name": "northsidegta-site",
  "version": "1.0.0",
  "description": "NorthSide GTA Real Estate Website",
  "main": "index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node scripts/generate-curated-html.js && node scripts/generate-sitemap.js && cp build/index.html build/404.html",
    "generate:curated": "node scripts/generate-curated-html.js",
    "ingest:events": "node scripts/ingest-events.js",
    "events:backfill-daily": "node scripts/backfill-daily-schedule.mjs",
    "events:audit": "node scripts/events-cli.mjs --audit",
    "test": "node --test"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "@vercel/kv": "^3.0.0",
    "classmates": "^1.0.1",
    "classnames": "^2.5.1",
    "emailjs-com": "^3.2.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.1",
    "lucide-react": "^0.522.0",
    "luxon": "^3.7.2",
    "node-html-parser": "^7.0.1",
    "node-ical": "^0.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.6.2",
    "react-scripts": "5.0.1",
    "resend": "^6.0.3",
    "rrule": "^2.8.1",
    "rss-parser": "^3.13.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2"
  }
}
