{
  "name": "northsidegta-site",
  "version": "1.0.0",
  "description": "NorthSide GTA Real Estate Website",
  "main": "index.js",
  "scripts": {
    "start": "react-scripts start",
    "prestart": "node scripts/sync-site-seo.js",
    "pretest": "node scripts/sync-site-seo.js",
    "prebuild": "node scripts/sync-site-seo.js && node scripts/generate-insights-data.js && node scripts/generate-insights-index.js",
    "build": "react-scripts build",
    "postbuild": "node scripts/generate-curated-html.js && node scripts/generate-insight-html.js && node scripts/generate-event-html.js && node scripts/generate-tastehub-html.js && node scripts/generate-static-route-html.js && node scripts/inject-community-static-html.js && node scripts/inject-homepage-static-html.js && node scripts/generate-sitemap.js && node scripts/check-insight-images.js && cp build/index.html build/404.html",
    "generate:curated": "node scripts/generate-curated-html.js",
    "ingest:events": "node scripts/ingest-events.js",
    "events:backfill-daily": "node scripts/backfill-daily-schedule.mjs",
    "events:connectivity": "node scripts/events-connectivity.mjs",
    "events:classify": "node scripts/events-classify.mjs",
    "events:health": "node scripts/events-health.mjs",
    "events:audit": "node scripts/events-cli.mjs --audit",
    "events:recover": "node scripts/events-recover.mjs",
    "events:normalize": "node scripts/events-normalize.mjs",
    "test": "node --test",
    "test:schema": "node --test tests/schema-*.test.cjs",
    "test:ios": "playwright test tests/ios-smoke.spec.ts --project=webkit",
    "generate:insights": "node scripts/generate-insights-data.js",
    "insights:migrate-images": "node scripts/migrate-insight-image-paths.js",
    "insights:check-images": "node scripts/check-insight-images.js",
    "seed:spotlights": "ts-node --transpile-only scripts/seedTownSpotlightsFromGoogle.ts",
    "seo:check": "node scripts/seo-check.cjs"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "@marsidev/react-turnstile": "^1.1.0",
    "@upstash/redis": "^1.28.4",
    "@vercel/analytics": "^1.0.0",
    "@vercel/blob": "^2.0.0",
    "@vercel/kv": "^3.0.0",
    "classmates": "^1.0.1",
    "classnames": "^2.5.1",
    "emailjs-com": "^3.2.0",
    "gray-matter": "^4.0.3",
    "html-entities": "^2.6.0",
    "html-to-image": "^1.11.13",
    "image-size": "^2.0.2",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.1",
    "lucide-react": "^0.522.0",
    "luxon": "^3.7.2",
    "marked": "^16.4.1",
    "node-fetch": "^3.3.2",
    "node-html-parser": "^7.0.1",
    "node-ical": "^0.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.6.2",
    "react-scripts": "5.0.1",
    "resend": "^6.0.3",
    "rrule": "^2.8.1",
    "rss-parser": "^13.0.0",
    "undici": "^7.16.0",
    "zod": "^3.23.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "ajv": "^8.17.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
